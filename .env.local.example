# Database
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/agri-ai?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=https://crop-iq-mzes.vercel.app/
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-key-here

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Groq AI (still required — src/app/api/analyze/route.ts depends on it)
GROQ_API_KEY=your-groq-api-key-here

# Ollama (local text-chat model — Phase 1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000

# Optional: Google OAuth (for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
