# Database
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/agri-ai?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=https://crop-iq-mzes.vercel.app/
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-key-here

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Groq AI (still required — src/app/api/analyze/route.ts depends on it)
GROQ_API_KEY=your-groq-api-key-here

# Ollama (local text-chat model — Phase 1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000

# Custom ML disease-prediction service (Phase 2 / Milestone M8)
# Server-side only -- never prefix these with NEXT_PUBLIC_. See
# docs/CUSTOM_ML_INTEGRATION.md for the full provider/fallback matrix.
# Allowed: "custom-ml" | "gemini". Requires CUSTOM_ML_ENABLED=true when set
# to "custom-ml" -- the app refuses to start with an inconsistent
# combination rather than silently ignoring this flag.
DISEASE_ANALYSIS_PROVIDER=gemini
# Master kill-switch for the custom ML provider. Must be true for
# DISEASE_ANALYSIS_PROVIDER=custom-ml to be accepted.
CUSTOM_ML_ENABLED=false
# Base URL of the ml-service FastAPI process (see ml-service/docs/API_FOUNDATION.md).
CUSTOM_ML_SERVICE_URL=http://127.0.0.1:8001
# Per-request timeout in milliseconds (1000-120000).
CUSTOM_ML_REQUEST_TIMEOUT_MS=15000
# When true, an unreachable/timed-out/malformed custom-ML response falls
# back to Gemini automatically. Never applies to user-caused 4xx errors
# (invalid/oversized/unsupported image).
CUSTOM_ML_FALLBACK_TO_GEMINI=true
# When true, GET /api/ready is checked before every prediction request
# (short in-memory TTL cache; never persisted).
CUSTOM_ML_REQUIRE_READY_CHECK=true

# Optional: Google OAuth (for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
