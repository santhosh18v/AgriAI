# ml-service local environment variables (separate from the Next.js
# .env.local.example at the repo root). Copy to ml-service/.env and fill in
# locally — ml-service/.env is gitignored and must never be committed.
#
# All settings use the AGRI_ML_ prefix (see app/config.py and
# docs/API_FOUNDATION.md). Every value below is optional; the app runs with
# safe defaults if this file is absent. No secrets are used in Milestone M6.

# --- Identity / server -------------------------------------------------
# AGRI_ML_APP_NAME=AgriAI ML Service
# AGRI_ML_APP_VERSION=Phase 2 development version
# AGRI_ML_ENVIRONMENT=development
# AGRI_ML_HOST=127.0.0.1
# AGRI_ML_PORT=8001
# AGRI_ML_LOG_LEVEL=info

# --- Approved model artifacts (default to the tracked, frozen M4/M5
# locations under ml-service/training/ and ml-service/data/) ------------
# AGRI_ML_MODEL_CHECKPOINT_PATH=./data/training-runs/m4-efficientnet-b0-seed42/best_model.pt
# AGRI_ML_CONFIDENCE_POLICY_PATH=./training/confidence_policy_v1.json
# AGRI_ML_CLASS_MAP_PATH=./training/class_map.json
# AGRI_ML_MODEL_SCOPE_PATH=./training/model_scope_v1.json

# --- Model loading -------------------------------------------------------
# AGRI_ML_PREFERRED_DEVICE=auto        # auto | cpu | mps | cuda
# AGRI_ML_EAGER_MODEL_LOAD=true

# --- HTTP / CORS (comma-separated or JSON array) --------------------------
# AGRI_ML_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
