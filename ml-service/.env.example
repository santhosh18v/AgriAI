# ml-service local environment variables (separate from the Next.js
# .env.local.example at the repo root). Copy to ml-service/.env and fill in
# locally — ml-service/.env is gitignored and must never be committed.

# Absolute or relative path to the trained model checkpoint file.
# No checkpoint exists yet (M1) — this is a placeholder path.
MODEL_PATH=./models/efficientnet_b0.pt

# Log verbosity for the FastAPI service.
LOG_LEVEL=info
